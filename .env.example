# ตัวแปรของ stack — ตรงกับ ${...} ทุกตัวใน docker-compose.yml
# Portainer: ใส่ในช่อง Environment variables ของ stack ไม่ต้องมีไฟล์นี้บนบอร์ด
# ⚠️ ห้าม commit .env จริง (NFR-07) — .gitignore กันไว้แล้ว

DB_USER=cmtk
DB_PASSWORD=                   # สุ่มมา ห้ามใช้ซ้ำกับที่อื่น
LOG_LEVEL=info

# จาก container บนบอร์ดใช้ที่อยู่ภายใน ไม่ต้อง TLS
MQTT_URL=mqtt://172.16.0.2:1883
MQTT_USER=user
MQTT_PASSWORD=
MQTT_TOPIC=balluff/cmtk/+/iolink/devices/#

LINE_ENABLED=false             # รอบแรกปิดไว้ก่อน เปิดเมื่อยืนยันว่าข้อมูลเข้าถูก
LINE_CHANNEL_ACCESS_TOKEN=
LINE_RECIPIENT_COUNT=5         # NFR-06 · 1 เหตุการณ์ = 5 ข้อความ (B-11)

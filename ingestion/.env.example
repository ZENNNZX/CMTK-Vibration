# ⚠️ ห้าม commit ไฟล์ .env จริง — ใส่ค่าจริงเฉพาะบนบอร์ด (NFR-07)
NODE_ENV=production
LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASSWORD@db:5432/cmtk_monitoring
DB_POOL_MAX=4

# จาก container บนบอร์ดใช้ที่อยู่ภายใน ไม่ต้อง TLS
MQTT_URL=mqtt://172.16.0.2:1883
MQTT_USER=user
MQTT_PASSWORD=
MQTT_TOPIC="balluff/cmtk/+/iolink/devices/#"

AGGREGATE_WINDOW_SECONDS=60
STALE_THRESHOLD_SECONDS=300

# broadcast = ไม่ต้องมี userId ไม่ต้องมี webhook
LINE_ENABLED=true
LINE_CHANNEL_ACCESS_TOKEN=
# NFR-06 · 1 เหตุการณ์ = LINE_RECIPIENT_COUNT ข้อความ — ตรวจกับคอนโซล LINE (B-11)
LINE_RECIPIENT_COUNT=5
LINE_DEBOUNCE_MINUTES=60
LINE_DAILY_CAP_PER_MOTOR=3
LINE_MONTHLY_MESSAGE_CAP=350
LINE_MONTHLY_RESERVE=150

# ⚠️ ห้าม commit ไฟล์ .env จริง (NFR-07)
NODE_ENV=production
LOG_LEVEL=info
PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@db:5432/cmtk_monitoring
DB_POOL_MAX=8

# NFR-01 · สุ่มใหม่ทุก environment: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# InfluxDB 2 — อนุกรมเวลาดิบ (ไม่ตั้ง = ถอยไปใช้ Postgres)
INFLUX2_URL=http://localhost:8086
INFLUX2_ORG=docs
INFLUX2_BUCKET=vibration_expand
INFLUX2_TOKEN=
